# mainnet | testnet
NETWORK=mainnet

# Injective EVM private key that submits redeems and pays the gas (fund it with a little INJ).
# Leave empty to run read-only (lookups work, redeem returns 503).
RELAYER_PRIVATE_KEY=

PORT=3000
# 127.0.0.1 keeps the API private when a reverse proxy (Caddy, nginx) sits in front of it.
HOST=0.0.0.0

# Allowed browser origins, comma-separated. * allows any app to call the API.
CORS_ORIGIN=*

# Per-IP limits. Redeem and swap requests share their own, stricter bucket, and so do holdings scans and onboarding plans
# (POST /holdings and /onboard/plan, which each ask dozens of RPCs and bridges; the app sends ~4 per scan).
RATE_LIMIT_PER_MINUTE=120
REDEEM_LIMIT_PER_MINUTE=5
ONBOARD_LIMIT_PER_MINUTE=40

# Set to true behind a reverse proxy so the client IP comes from X-Forwarded-For (needed for per-IP limits).
TRUST_PROXY=false

# Ignore transfers smaller than this many USDC (0 redeems everything).
MIN_REDEEM_USDC=0

# Largest USDC → INJ swap (Get INJ). The relayer holds the user's USDC for the few seconds the order takes.
SWAP_MAX_USDC=10000

# Address search index (SQLite). On first start it backfills this many hours of history.
DB_PATH=cctp.sqlite
INDEX_LOOKBACK_HOURS=72
INDEX_POLL_SECONDS=30

# Optional RPC overrides, comma-separated URLs act as fallbacks. Public RPCs are used otherwise,
# but they are slow and rate limited, so set real ones for production.
# RPC_INJECTIVE=
# RPC_ETHEREUM=
# RPC_ARBITRUM=
# RPC_BASE=
# RPC_OP_MAINNET=
# RPC_AVALANCHE=
# RPC_POLYGON=
# Also: RPC_UNICHAIN, RPC_LINEA, RPC_CODEX, RPC_SONIC, RPC_WORLD_CHAIN, RPC_MONAD, RPC_SEI, RPC_XDC,
# RPC_HYPEREVM, RPC_INK, RPC_PLUME, RPC_ARC, RPC_EDGE, RPC_MORPH, RPC_PHAROS, RPC_CRONOS, RPC_PLASMA, RPC_X_LAYER
# Solana (balances, transfer status, and sending the UI's Solana transactions). The public one is heavily rate limited.
# RPC_SOLANA=
# Any other EVM chain the bridges reach, by its id in GET /chains (networks): RPC_<ID>, for balances and token lookups.
# RPC_BNB=
# RPC_MANTA_PACIFIC=

# Cosmos chains are reached over REST (accounts, simulating, broadcasting and balances). By default that's cosmos.directory's
# shared, rate-limited proxy; set REST_<ID> (comma-separated for fallback) for the chains you expect traffic on.
# REST_OSMOSIS=
# REST_INJECTIVE_COSMOS=
# REST_COSMOSHUB=
# REST_NOBLE=

# Other bridges, quoted next to CCTP (POST /quotes), and the chains they reach. All optional except as noted.
# LI.FI: without a key the whole server shares 200 requests per 2 hours, so set one in production (https://portal.li.fi).
# LIFI_API_KEY=
# Skip Go carries every route from and to Cosmos chains. Without a key the whole server shares Skip's anonymous rate limit,
# so set one in production (from Skip's Discord).
# SKIP_API_KEY=
# LayerZero's Value Transfer API: off unless set (keys from LayerZero). It also adds Aptos, Stellar, Starknet and IOTA.
# LAYERZERO_API_KEY=
# Higher rate limits. deBridge: https://forms.gle/doWLQpr8oemphoaf9. Relay: https://dashboard.relay.link
# (Relay says /quote/v2 will need one). Across: an API key and a 2-byte hex integrator id, https://docs.across.to/tools/integrator-id
# DEBRIDGE_API_KEY=
# RELAY_API_KEY=
# ACROSS_API_KEY=
# ACROSS_INTEGRATOR_ID=
