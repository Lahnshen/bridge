[Unit]
Description=Lahn Bridge API
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
WorkingDirectory=/opt/bridge/backend
# Bun loads backend/.env from the working directory.
ExecStart=/home/deploy/.bun/bin/bun src/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
